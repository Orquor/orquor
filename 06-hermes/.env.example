# Orquor Hermes — environment configuration
# Copy to .env and fill values. Never commit .env to git.

# LLM providers (default + fallback)
ANTHROPIC_API_KEY=sk-ant-...
OPENAI_API_KEY=sk-...

# Local LLM endpoint (Llama 3.3 70B on A100 MIG, for PHI)
LOCAL_LLM_ENDPOINT=https://internal.orquor.com/llm
LOCAL_LLM_API_KEY=...

# Vector store
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=

# Postgres
DATABASE_URL=postgresql://orquor:password@localhost:5432/orquor_hermes

# Observability
LANGSMITH_API_KEY=ls__...
LANGSMITH_PROJECT=orquor-hermes-prod
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318

# OSINT data sources (Watchtower-Bot)
LINKEDIN_MONITORING_API_KEY=
CRUNCHBASE_API_KEY=
GITHUB_TOKEN=ghp_...

# Compliance monitoring sources
INDECOPI_USER=
INDECOPI_PASS=

# Cryptographic timestamping
OPENTIMESTAMPS_CALENDAR=https://alice.btc.calendar.opentimestamps.org

# Notification channels
SIGNAL_CLI_PHONE=+51...
EMAIL_FROM=hermes@orquor.com
EMAIL_TO_FOUNDER=freddy@orquor.com
RESEND_API_KEY=re_...

# Operating mode
HERMES_MODE=development   # development | staging | production
