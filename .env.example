# ═══════════════════════════════════════════════════════════════════
# ORQUOR — Environment Configuration
# ═══════════════════════════════════════════════════════════════════
# Copy this file to .env and fill in real values.
#   cp .env.example .env
# Never commit .env to git — it's in .gitignore.
#
# Categories:
#   1. HOSTING       — Deploy a Hostinger (FTP/SSH)
#   2. LLM           — AI model providers
#   3. DATABASE      — PostgreSQL + vector store
#   4. OBSERVABILITY — LangSmith, OpenTelemetry
#   5. OSINT         — Data sources for Watchtower-Bot
#   6. COMPLIANCE    — Regulatory monitoring (Indecopi, etc.)
#   7. TIMESTAMPING  — Cryptographic proof
#   8. NOTIFICATIONS — Email, Signal alerts
#   9. MODE          — Runtime environment

# ═══════════════════════════════════════════════════════════════════
# 1. HOSTING — Deploy to Hostinger
# ═══════════════════════════════════════════════════════════════════
# FTP credentials for lftp deploy (scripts/deploy-landing.sh)
HOSTINGER_FTP_HOST=ftp.orquor.com
HOSTINGER_FTP_USER=tu_usuario_ftp
HOSTINGER_FTP_PASS=tu_password_ftp

# SSH credentials for rsync deploy (optional, alternative to FTP)
# HOSTINGER_SSH_HOST=ssh.orquor.com
# HOSTINGER_SSH_USER=tu_usuario_ssh

# ═══════════════════════════════════════════════════════════════════
# 2. LLM — AI Model Providers
# ═══════════════════════════════════════════════════════════════════
# Primary language model (Claude via Anthropic)
ANTHROPIC_API_KEY=sk-ant-...

# Fallback provider (OpenAI GPT-4)
OPENAI_API_KEY=sk-...

# Local LLM endpoint for PHI-sensitive workloads (Llama 3.3 70B on A100 MIG)
# LOCAL_LLM_ENDPOINT=https://internal.orquor.com/llm
# LOCAL_LLM_API_KEY=...

# ═══════════════════════════════════════════════════════════════════
# 3. DATABASE — PostgreSQL + Vector Store
# ═══════════════════════════════════════════════════════════════════
# Main PostgreSQL database (Hermes platform)
DATABASE_URL=postgresql://orquor:password@localhost:5432/orquor_hermes

# Qdrant vector database for embeddings/semantic search
QDRANT_URL=http://localhost:6333
# QDRANT_API_KEY=...  # Only if using Qdrant Cloud

# ═══════════════════════════════════════════════════════════════════
# 4. OBSERVABILITY — LangSmith + OpenTelemetry
# ═══════════════════════════════════════════════════════════════════
# LangSmith for LLM trace observability
LANGSMITH_API_KEY=ls__...
LANGSMITH_PROJECT=orquor-hermes-prod

# OpenTelemetry collector endpoint
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318

# ═══════════════════════════════════════════════════════════════════
# 5. OSINT — Watchtower-Bot Data Sources
# ═══════════════════════════════════════════════════════════════════
# LinkedIn monitoring API
# LINKEDIN_MONITORING_API_KEY=...

# Crunchbase company data API
# CRUNCHBASE_API_KEY=...

# GitHub token for repo monitoring (fine-grained, read-only on public repos)
# GITHUB_TOKEN=github_pat_...

# ═══════════════════════════════════════════════════════════════════
# 6. COMPLIANCE — Regulatory Monitoring (Peru)
# ═══════════════════════════════════════════════════════════════════
# INDECOPI — National Institute for the Defense of Competition and IP
# INDECOPI_USER=...
# INDECOPI_PASS=...

# ═══════════════════════════════════════════════════════════════════
# 7. TIMESTAMPING — Cryptographic Proof
# ═══════════════════════════════════════════════════════════════════
# OpenTimestamps calendar for audit trail immutability
# OPENTIMESTAMPS_CALENDAR=https://alice.btc.calendar.opentimestamps.org

# ═══════════════════════════════════════════════════════════════════
# 8. NOTIFICATIONS — Email + Signal Alerts
# ═══════════════════════════════════════════════════════════════════
# Signal CLI for urgent alerts (WhatsApp alternative for LatAm)
# SIGNAL_CLI_PHONE=+51...

# Email sender (Resend API)
EMAIL_FROM=hermes@orquor.com
EMAIL_TO_FOUNDER=freddy@orquor.com
RESEND_API_KEY=re_...

# ═══════════════════════════════════════════════════════════════════
# 9. MODE — Runtime Environment
# ═══════════════════════════════════════════════════════════════════
# development | staging | production
HERMES_MODE=development

# ═══════════════════════════════════════════════════════════════════
# 10. ADDITIONAL — Project-specific
# ═══════════════════════════════════════════════════════════════════
# Project root (used by scripts that don't auto-detect)
# PROJECT_ROOT=/mnt/c/Users/frefe/OneDrive/Desktop/START UP/orquor

# Backup directory (used by backup.sh)
# BACKUP_DIR=/home/frefe/backups/orquor

# Content calendar config (used by scripts/publish.sh)
# CONTENT_DIR=09-content-calendar

# GitHub organization name (used by setup-github.sh)
# GITHUB_ORG=orquor
# GITHUB_USER=orquor-freddy
